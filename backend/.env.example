NODE_ENV=development
PORT=4000

# Pooled Neon connection string used by the running Express app.
# Use the host that ends in `-pooler.<region>.aws.neon.tech`.
DATABASE_URL=postgresql://user:password@project-pooler.region.aws.neon.tech/dbname?sslmode=require

# Optional direct (non-pooled) connection string used by migrations and seeds.
# Falls back to DATABASE_URL when unset.
DATABASE_URL_DIRECT=

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
