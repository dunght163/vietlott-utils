								arr_lotoduoi[countloto] = (loaixs[xoso].kq[dai][3][v - 1]).substr(loaixs[xoso].kq[dai][3][v - 1].length - 2, 2);
								countloto++;
							}
							// giai 2 1
							for (v = 2; v >= 1; v--) {
								if (loaixs[xoso].kq[dai][v]) {
