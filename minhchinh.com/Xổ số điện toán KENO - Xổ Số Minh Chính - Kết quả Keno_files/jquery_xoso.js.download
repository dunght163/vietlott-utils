			cache: ajaxcache,
			success: function (msg) {
				if (msg != '') {
					//alert(msg);
					delay = xsdt[xoso].delay;
					runtt = xsdt[xoso].runtt;
					newtime = xsdt[xoso].newtime;
					if (newtime == lasttime) {

						if (runtt == 0) {
							delay = delay * 5;
							thongbaonoxstt_vietlott();
