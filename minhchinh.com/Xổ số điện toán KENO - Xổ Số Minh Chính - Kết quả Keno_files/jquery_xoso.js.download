						duoi5 = " ";
						duoi6 = " ";
						duoi7 = " ";
						duoi8 = " ";
						duoi9 = " ";
						for (var i = 0; i < loaixs[xoso].dai.length; i++) {
							var dai = loaixs[xoso].dai[i];
							arr_loto = new Array();
							arr_loto2 = new Array();
							countloto = 0;
							for (var n = 0; n <= 9; n++) duoi[n] = '';
